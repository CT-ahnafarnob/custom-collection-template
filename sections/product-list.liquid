{% liquid
  assign max_items = section.settings.max_products
  assign products_to_display = section.settings.collection.products | default: empty
%}

<!-- Prepare products data for filter component - FRESH DATA -->
<script>
  // Force fresh data - clear any cache
  {% assign safe_id = section.id | replace: "-", "_" %}
  const allProductsData_{{ safe_id }} = [
    {% if section.settings.collection %}
      {% paginate section.settings.collection.products by 250 %}
        {% for product in section.settings.collection.products %}
          {
            id: "{{ product.id }}",
            title: "{{ product.title | escape }}",
            handle: "{{ product.handle }}",
            price: {{ product.price | divided_by: 100.0 }},
            image: "{{ product.featured_image | image_url: width: 300 }}",
            type: "{{ product.type | strip | escape }}",
            vendor: "{{ product.vendor | escape }}",
            url: "{{ product.url }}"
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% paginate shop.products by 250 %}
        {% for product in shop.products %}
          {
            id: "{{ product.id }}",
            title: "{{ product.title | escape }}",
            handle: "{{ product.handle }}",
            price: {{ product.price | divided_by: 100.0 }},
            image: "{{ product.featured_image | image_url: width: 300 }}",
            type: "{{ product.type | strip | escape }}",
            vendor: "{{ product.vendor | escape }}",
            url: "{{ product.url }}"
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% endif %}
  ];
</script>

<!-- Generic Self-Contained Styles -->
<style>
  #shopify-section-{{ section.id }} .generic-product-list {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .generic-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Header Styles */
  #shopify-section-{{ section.id }} .generic-header {
    display: flex;
    justify-content: {{ section.settings.header_alignment }};
    align-items: center;
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .generic-heading {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .generic-view-all {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.link_color }};
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
  }

  #shopify-section-{{ section.id }} .generic-view-all:hover {
    border-color: currentColor;
    opacity: 0.8;
  }

  /* Grid Styles */
  #shopify-section-{{ section.id }} .generic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: {{ section.settings.gap }}px;
    width: 100%;
  }

  /* Card Styles */
  #shopify-section-{{ section.id }} .generic-card {
    background: {{ section.settings.card_bg }};
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .generic-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.08);
  }

  #shopify-section-{{ section.id }} .generic-card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .generic-image-wrapper {
    position: relative;
    width: 100%;
    padding-top: 100%; /* 1:1 Aspect Ratio */
    background: #f4f4f4;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .generic-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .generic-card:hover .generic-image {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .generic-info {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .generic-title {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  #shopify-section-{{ section.id }} .generic-price {
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.price_color }};
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .generic-type {
    font-size: 12px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
  }

  /* Pagination Styles */
  #shopify-section-{{ section.id }} .generic-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #eee;
  }

  #shopify-section-{{ section.id }} .generic-pagination-btn {
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
    font-size: 18px;
    transition: all 0.2s ease;
  }

  #shopify-section-{{ section.id }} .generic-pagination-btn:hover:not(:disabled) {
    background: #000;
    color: #fff;
    border-color: #000;
  }

  #shopify-section-{{ section.id }} .generic-pagination-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .generic-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  /* Fade Animation */
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<div class="generic-product-list">
  <div class="generic-container">
    
    <!-- Render Header Blocks -->
    <div class="generic-header">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="generic-heading" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- when 'view_all' -%}
            {%- if block.settings.text != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="generic-view-all" {{ block.shopify_attributes }}>
                {{ block.settings.text | escape }}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <!-- Product Filter Component -->
    <script src="{{ 'product-filter.js' | asset_url }}"></script>
    <product-filter id="product-filter-{{ section.id }}"></product-filter>

    <!-- Products Grid -->
    <div id="filtered-products-container-{{ section.id }}">
      <div id="products-grid-{{ section.id }}" class="generic-grid">
        {% if section.settings.collection != blank %}
          {% paginate section.settings.collection.products by 250 %}
            {% for product in section.settings.collection.products %}
              {% render 'generic-card-loop', product: product %}
            {% endfor %}
          {% endpaginate %}
        {% else %}
          {% paginate shop.products by 250 %}
            {% for product in shop.products %}
              {% render 'generic-card-loop', product: product %}
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </div>
      
      <!-- No Results -->
      <div id="no-results-message-{{ section.id }}" style="display: none; text-align: center; padding: 60px 20px; color: #888;">
        <p>No products found. Try changing your filters.</p>
      </div>
    </div>

    <!-- Pagination -->
    <div class="generic-pagination" id="pagination-container-{{ section.id }}" style="display: none;">
      <button class="generic-pagination-btn" id="prev-btn-{{ section.id }}">←</button>
      <span id="pagination-info-{{ section.id }}" style="font-size: 14px; color: #666;">Page 1</span>
      <button class="generic-pagination-btn" id="next-btn-{{ section.id }}">→</button>
    </div>
    
  </div>
</div>

<!-- Inline snippet for the loop to keep code clean but avoid external file dependency if possible. 
     Actually, let's keep it inline like before to be truly portable. -->
{% capture card_markup %}
  <!-- This is just a capture hack to invoke the logic below without repeating code -->
{% endcapture %}

<!-- Re-implementing the loop inline using a consistent structure -->
<script>
  // Filter Initialization Logic
  function initializeFilter_{{ safe_id }}() {
    const productFilter = document.getElementById('product-filter-{{ section.id }}');
    if (productFilter && typeof allProductsData_{{ safe_id }} !== 'undefined' && allProductsData_{{ safe_id }}.length > 0) {
      productFilter.setAttribute('data-products', JSON.stringify(allProductsData_{{ safe_id }}));
    } else if (productFilter) {
      setTimeout(initializeFilter_{{ safe_id }}, 100);
    }
  }
  
  // DOM Ready Check
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeFilter_{{ safe_id }});
  } else {
    initializeFilter_{{ safe_id }}();
  }

  // Filter Event Handlers & Pagination Logic
  function setupFilterListeners_{{ safe_id }}() {
      const productFilter = document.getElementById('product-filter-{{ section.id }}');
      const noResultsMessage = document.getElementById('no-results-message-{{ section.id }}');
      const paginationContainer = document.getElementById('pagination-container-{{ section.id }}');
      const prevBtn = document.getElementById('prev-btn-{{ section.id }}');
      const nextBtn = document.getElementById('next-btn-{{ section.id }}');
      const paginationInfo = document.getElementById('pagination-info-{{ section.id }}');

      if (!productFilter) return;

      let allCards = Array.from(document.querySelectorAll('#products-grid-{{ section.id }} .generic-card'));
      let visibleCards = [];
      let currentPage = 1;
      const itemsPerPage = {{ section.settings.max_products | default: 12 }};

      function renderPage() {
        const totalPages = Math.ceil(visibleCards.length / itemsPerPage);
        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;

        allCards.forEach(card => card.style.display = 'none');

        visibleCards.slice(startIndex, endIndex).forEach(card => {
          card.style.display = 'flex'; // generic-card is the wrapper
          card.style.animation = 'fadeIn 0.5s ease forwards';
        });

        if (visibleCards.length > itemsPerPage) {
          paginationContainer.style.display = 'flex';
          paginationInfo.textContent = `Page ${currentPage} of ${totalPages}`;
          prevBtn.disabled = currentPage === 1;
          nextBtn.disabled = currentPage === totalPages;
        } else {
          paginationContainer.style.display = 'none';
        }

        noResultsMessage.style.display = visibleCards.length === 0 ? 'block' : 'none';
        
        if (productFilter.updateCount) {
          productFilter.updateCount(visibleCards.length);
        }
      }

      function applyFilter(filters) {
        visibleCards = allCards.filter(card => {
          const productType = card.getAttribute('data-product-type') || '';
          const productTitle = card.getAttribute('data-product-title') || '';
          const productPrice = parseFloat(card.getAttribute('data-product-price')) || 0;
          
          let matchesCategory = !filters.categories || filters.categories.length === 0 || filters.categories.includes(productType);
          let matchesSearch = !filters.search || productTitle.includes(filters.search.toLowerCase());
          let matchesPrice = (!filters.priceMin && filters.priceMin !== 0) || (productPrice >= filters.priceMin && productPrice <= filters.priceMax);

          return matchesCategory && matchesSearch && matchesPrice;
        });
        currentPage = 1;
        renderPage();
      }

      productFilter.addEventListener('filter-applied', (e) => applyFilter(e.detail));
      productFilter.addEventListener('filter-reset', () => {
        visibleCards = [...allCards];
        currentPage = 1;
        renderPage();
      });

      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; renderPage(); }
      });

      nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(visibleCards.length / itemsPerPage);
        if (currentPage < totalPages) { currentPage++; renderPage(); }
      });

      visibleCards = [...allCards];
      renderPage();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFilterListeners_{{ safe_id }});
  } else {
    setupFilterListeners_{{ safe_id }}();
  }
</script>

{% schema %}
{
  "name": "Generic Product List",
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
          "default": "All Products"
        }
      ]
    },
    {
      "type": "view_all",
      "name": "View All Button",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Button Label",
          "default": "View All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container Width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space Between" }
      ],
      "default": "space-between"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products per Page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "header",
      "content": "Look & Feel"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Button/Link Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Generic Product List",
      "settings": {
        "max_products": 12,
        "gap": 24
      }
    }
  ]
}
{% endschema %}